# Fine-tuning Docker Environment Configuration
# Copy this file to .env.finetune and modify as needed

# =============================================================================
# BASIC CONFIGURATION
# =============================================================================

# Service configuration
FINETUNE_LOG_LEVEL=INFO
FINETUNE_MAX_WORKERS=4
FINETUNE_TIMEOUT=14400

# User/Group IDs (for file permissions)
UID=1000
GID=1000

# =============================================================================
# GPU CONFIGURATION
# =============================================================================

# Enable CUDA support (true/false)
USE_CUDA=false

# CUDA version (cu117, cu118, cu121, cu124, etc.)
USE_CUDA_VER=cu121

# GPU device IDs (comma-separated, e.g., "0,1" or "0")
CUDA_VISIBLE_DEVICES=

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Memory limits (adjust based on your hardware)
MEMORY_LIMIT=16G
MEMORY_RESERVATION=8G

# CPU limits (adjust based on your hardware)
CPU_LIMIT=8.0
CPU_RESERVATION=4.0

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Ollama configuration
OLLAMA_BASE_URL=http://ollama:11434

# Optional: Local models directory (mount point)
LOCAL_MODELS_PATH=./models

# =============================================================================
# MONITORING (Optional)
# =============================================================================

# Grafana admin password
GRAFANA_PASSWORD=admin

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Hugging Face cache directory
HF_HOME=/app/cache/huggingface

# Transformers cache directory
TRANSFORMERS_CACHE=/app/cache/transformers

# PyTorch cache directory
TORCH_HOME=/app/cache/torch

# =============================================================================
# TRAINING CONFIGURATION
# =============================================================================

# Default training parameters (can be overridden via API)
DEFAULT_LEARNING_RATE=0.0001
DEFAULT_EPOCHS=3
DEFAULT_BATCH_SIZE=4
DEFAULT_LORA_RANK=16
DEFAULT_LORA_ALPHA=32

# Model size categories
SMALL_MODEL_THRESHOLD=3B
MEDIUM_MODEL_THRESHOLD=14B
LARGE_MODEL_THRESHOLD=32B

# =============================================================================
# SECURITY
# =============================================================================

# API secret key (generate a secure random string)
WEBUI_SECRET_KEY=your-secret-key-here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/app/backend/logs/finetune.log

# Maximum log file size (MB)
MAX_LOG_SIZE=100

# Number of log files to keep
LOG_BACKUP_COUNT=5
