# syntax=docker/dockerfile:1
# Dockerfile for Fine-tuning Backend Service
# This Dockerfile creates a container specifically for the LoRA fine-tuning functionality

# Build arguments for configuration
ARG USE_CUDA=false
ARG USE_CUDA_VER=cu121
ARG PYTHON_VERSION=3.11
ARG UID=1000
ARG GID=1000

# Use Python 3.11 slim as base image
FROM python:${PYTHON_VERSION}-slim-bookworm AS base

# Set build arguments
ARG USE_CUDA
ARG USE_CUDA_VER
ARG UID
ARG GID

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/app/cache/huggingface \
    TRANSFORMERS_CACHE=/app/cache/transformers \
    TORCH_HOME=/app/cache/torch \
    CUDA_VISIBLE_DEVICES="" \
    USE_CUDA_DOCKER=${USE_CUDA} \
    USE_CUDA_DOCKER_VER=${USE_CUDA_VER}

# Create app user and directories
RUN groupadd -g ${GID} appuser && \
    useradd -r -u ${UID} -g appuser -d /app -s /bin/bash appuser && \
    mkdir -p /app/backend /app/cache/huggingface /app/cache/transformers /app/cache/torch /app/data /app/logs && \
    chown -R ${UID}:${GID} /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    gcc \
    g++ \
    make \
    cmake \
    # Python development
    python3-dev \
    python3-pip \
    # System utilities
    curl \
    wget \
    git \
    jq \
    htop \
    vim \
    # Network tools
    netcat-openbsd \
    # Math libraries
    libopenblas-dev \
    liblapack-dev \
    libatlas-base-dev \
    # Image processing (for document processing)
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libwebp-dev \
    # Audio processing (for whisper)
    ffmpeg \
    libsndfile1 \
    # CUDA dependencies (if needed)
    && if [ "$USE_CUDA" = "true" ]; then \
        apt-get install -y --no-install-recommends \
        nvidia-cuda-toolkit \
        nvidia-cuda-dev; \
    fi \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch to app user
USER appuser
WORKDIR /app/backend

# Copy requirements first for better caching
COPY --chown=${UID}:${GID} backend/requirements.txt ./

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    if [ "$USE_CUDA" = "true" ]; then \
        # Install PyTorch with CUDA support
        pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/${USE_CUDA_VER} && \
        pip install -r requirements.txt; \
    else \
        # Install PyTorch CPU-only version
        pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
        pip install -r requirements.txt; \
    fi

# Install additional ML dependencies
RUN pip install \
    # Core ML libraries
    transformers>=4.30.0 \
    peft>=0.4.0 \
    datasets>=2.12.0 \
    accelerate>=0.20.0 \
    bitsandbytes>=0.39.0 \
    # Training utilities
    wandb \
    tensorboard \
    # Data processing
    pandas \
    numpy \
    scipy \
    scikit-learn \
    # Text processing
    nltk \
    spacy \
    # Model conversion
    safetensors \
    # Additional utilities
    tqdm \
    psutil \
    GPUtil \
    # GGUF support
    gguf \
    # Ollama integration
    ollama

# Copy backend files
COPY --chown=${UID}:${GID} backend/ ./

# Create necessary directories
RUN mkdir -p \
    /app/backend/training_logs \
    /app/backend/adapter_exports \
    /app/backend/merged_models \
    /app/backend/rag_models \
    /app/backend/data/uploads \
    /app/backend/data/cache \
    /app/backend/data/vector_db

# Set proper permissions
RUN chmod +x *.py *.sh 2>/dev/null || true

# Create startup script
RUN cat > /app/backend/start_finetune.sh << 'EOF'
#!/bin/bash
set -e

echo "=== Fine-tuning Backend Service Starting ==="
echo "Python version: $(python --version)"
echo "PyTorch version: $(python -c 'import torch; print(torch.__version__)')"
echo "CUDA available: $(python -c 'import torch; print(torch.cuda.is_available())')"
echo "Working directory: $(pwd)"

# Check if Ollama is available
if command -v ollama &> /dev/null; then
    echo "Ollama found: $(ollama --version)"
else
    echo "Warning: Ollama not found in PATH"
fi

# Start the fine-tuning API
echo "Starting fine-tuning API server..."
exec python fine_tuning_api.py
EOF

RUN chmod +x /app/backend/start_finetune.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Expose port
EXPOSE 8001

# Set environment variables for the service
ENV FINETUNE_API_HOST=0.0.0.0 \
    FINETUNE_API_PORT=8001 \
    FINETUNE_LOG_LEVEL=INFO \
    FINETUNE_MAX_WORKERS=4 \
    FINETUNE_TIMEOUT=14400

# Default command
CMD ["/app/backend/start_finetune.sh"]
